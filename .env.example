# ─────────────────────────────────────────────────────────────
# Cali Clean · Lead Machine · configuración
# Copia este archivo a .env y rellena los valores reales.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
# URL pública donde corre esta app (sin barra final). Se usa en enlaces de emails.
APP_URL=https://leads.cali-clean.net

# ── Negocio ──────────────────────────────────────────────────
BUSINESS_NAME=Cali Clean
BUSINESS_SITE=https://cali-clean.net
BUSINESS_EMAIL=info@cali-clean.net
BUSINESS_PHONE=+1 (000) 000-0000
# Dirección física: obligatoria por CAN-SPAM en el pie de los correos.
BUSINESS_ADDRESS=123 Main St, Los Angeles, CA 90001
BUSINESS_HOURS=Mon-Sat 8:00-18:00
# Códigos postales donde se presta servicio, separados por coma. Vacío = todos.
SERVICE_ZIPS=90001,90002,90003,90012,90028,90045,90066,90210,90230,90401,91201,91801
# Enlace de reserva/agenda (Calendly, Google Calendar, tu propio checkout...)
BOOKING_URL=https://cali-clean.net/contact
REVIEWS_URL=https://g.page/cali-clean/review

# ── Emails salientes ─────────────────────────────────────────
MAIL_FROM_NAME=Cali Clean
MAIL_FROM_EMAIL=hello@cali-clean.net
MAIL_REPLY_TO=info@cali-clean.net
# Destinatarios internos de aviso de lead nuevo (coma)
MAIL_NOTIFY_TO=info@cali-clean.net

# Driver de envío: smtp | api | log
#   smtp -> Sender SMTP (recomendado y verificado)
#   api  -> Sender REST transaccional
#   log  -> no envía nada, escribe en consola y BBDD (para pruebas)
MAIL_DRIVER=smtp

# ── Sender · SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.sender.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Sender · API ─────────────────────────────────────────────
# Token: Sender -> Settings -> API access tokens
SENDER_API_TOKEN=
SENDER_API_BASE=https://api.sender.net/v2
# Endpoint transaccional (ajústalo si tu cuenta usa otra ruta)
SENDER_TRANSACTIONAL_PATH=/email
# Sincronizar cada lead como suscriptor de Sender (para campañas/automations)
SENDER_SYNC_SUBSCRIBERS=true
# IDs de grupo de Sender (Audience -> Groups). Opcionales.
SENDER_GROUP_ALL=
SENDER_GROUP_RESIDENTIAL=
SENDER_GROUP_COMMERCIAL=
SENDER_GROUP_HOT=

# ── Panel de administración ──────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave
# Secreto para firmar tokens de baja y tracking (cadena larga y aleatoria)
APP_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# ── Motor de secuencias ──────────────────────────────────────
# Intervalo del worker en minutos
SEQUENCE_TICK_MINUTES=5
# Ventana horaria en la que se permiten envíos (hora local del negocio, 24h)
SEQUENCE_SEND_FROM=8
SEQUENCE_SEND_TO=20
BUSINESS_TZ=America/Los_Angeles

# ── Seguridad del formulario ─────────────────────────────────
# Orígenes permitidos para el widget (coma). Vacío = cualquiera.
CORS_ORIGINS=https://cali-clean.net,https://www.cali-clean.net
# Máximo de envíos por IP y hora
RATE_LIMIT_PER_HOUR=8

# ═════════════════════════════════════════════════════════════
# PROSPECCIÓN OUTBOUND (agentes que alimentan el CRM)
# ═════════════════════════════════════════════════════════════

# Interruptor general. En false los agentes siguen prospectando y llenando
# el CRM, pero NO sale ni un correo. Enciéndelo solo cuando el dominio esté
# autenticado (SPF, DKIM, DMARC) y hayas revisado los primeros correos.
OUTBOUND_ENABLED=false

# Tope de correos en frío por día, una vez terminado el calentamiento.
OUTBOUND_DAILY_LIMIT=40
# Calentamiento: empieza en N y sube un escalón cada día hasta el tope.
# Pon la fecha del día en que arrancas. Sin fecha, no hay calentamiento.
OUTBOUND_WARMUP_START=10
OUTBOUND_WARMUP_STEP=5
OUTBOUND_WARMUP_START_DATE=
# Días que deben pasar antes de volver a escribir a otro buzón del mismo dominio.
OUTBOUND_DOMAIN_COOLDOWN_DAYS=90
# Puntuación ICP mínima para que un prospecto reciba correo.
OUTBOUND_MIN_ICP_SCORE=45
# Comprobar que el dominio recibe correo (registro MX) antes de enviar.
OUTBOUND_REQUIRE_MX=true
# Aviso de procedencia en el pie de cada correo en frío. Obligatorio de facto.
OUTBOUND_DISCLOSURE_ES=
OUTBOUND_DISCLOSURE_EN=

# ── Agentes de prospección ───────────────────────────────────
# Fuentes activas (coma). Ver src/prospecting/sources/index.js:
#   sdcounty_food_facility_permits  (SODA, implementado)
#   sd_business_tax_certificates    (csv-static, SIN implementar)
#   sd_development_approvals        (csv-static, solo investigación)
#
# Estar en esta lista no habilita nada: la auditoría manda. Al 2026-10-03
# ninguna fuente está habilitada. Ver docs/source-verification.md.
PROSPECT_SOURCES=sdcounty_food_facility_permits
PROSPECT_DISCOVER_LIMIT=50
PROSPECT_ENRICH_LIMIT=40
# Pausa entre peticiones al mismo sitio. No lo bajes de 1000.
PROSPECT_CRAWL_DELAY_MS=2000
PROSPECT_TIMEOUT_MS=12000
# Identifícate: un bot anónimo es un bot bloqueado.
PROSPECT_USER_AGENT=CaliCleanProspector/1.0 (+https://cali-clean.net/bot; contact: info@cali-clean.net)
# Cada cuántos minutos salen los agentes a buscar.
PROSPECT_TICK_MINUTES=60
# Token de Socrata (opcional, sube el límite de peticiones): https://evergreen.data.socrata.com/signup
SOCRATA_APP_TOKEN=

# ── Redacción con Claude ─────────────────────────────────────
# Con esto apagado, los correos se componen desde plantillas.
AI_COPY_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low

# ── Twenty CRM ───────────────────────────────────────────────
# URL de la instancia. La credencial NO va aquí en esta sesión: el entorno
# inyecta el Authorization para el dominio autorizado.
TWENTY_BASE_URL=https://crm.cali-clean.net
# Solo para despliegues externos (el VPS, por ejemplo), donde no hay inyección.
# Su valor no se imprime nunca en logs ni en mensajes de error.
TWENTY_API_KEY=
# El dry-run es el valor por defecto. Ponlo en true solo cuando quieras que
# `twenty-sync.js apply --confirm` pueda escribir de verdad.
TWENTY_WRITE_ENABLED=false

# ── Fuentes de datos públicos ────────────────────────────────
# Dos capas, y hacen falta las dos para que una fuente salga a la red:
#   1. EVIDENCIA   config/source-allowlist.json (versionado, lo escribe una
#      persona tras auditar). Ahí viven `eligible` y `enabled`, que NO son lo
#      mismo: elegible es permiso legal, habilitada es decisión operativa.
#   2. CONSTANCIA  una de estas dos, y basta con una:
#      · config/source-attestation.json — evidencia importada, con hash. La
#        trae el operador desde una red autorizada y se comprueba offline:
#            node scripts/verify-attestation.js
#      · data/source-compliance.json — constancia local (fuera de git, caduca).
#            node scripts/verify-sources.js <clave> --terms-ok
# Estado de todo:  node scripts/verify-sources.js
# Dry-run sin red: node scripts/dry-run-source.js
SOURCE_ATTESTATION_MAX_AGE_DAYS=180
# Rutas alternativas (útiles en pruebas y despliegues con varios clientes).
# SOURCE_ALLOWLIST_PATH=
# SOURCE_ATTESTATION_PATH=
# Constancia importada con hash (por defecto config/source-attestation.json).
# SOURCE_ATTESTATION_FILE=

# Control de caudal de las fuentes. El estado vive fuera de git porque es de
# esta máquina: 50 filas por corrida y una corrida con éxito cada 24 h.
# SOURCE_RUNTIME_STATE_PATH=data/source-runtime-state.json

# OJO con los contenedores efímeros (la Routine en Cloud corre en uno): ese
# archivo NO sobrevive entre ejecuciones, así que es solo la segunda defensa.
# Las dos cosas durables se derivan del CRM, sin registros de control:
#   · dónde se quedó  → la dedupKey más baja del prefijo (cursor.js)
#   · cuándo se corrió → el lastVerified más reciente del prefijo, entre las
#     ACTIVAS (durable-quota.js). Menos de 24 h ⇒ no se toca el portal.

# Temporal donde se descarga un CSV estático. El archivo se borra siempre al
# terminar la corrida, porque el de la Ciudad contiene nombres de personas.
# SOURCE_CSV_TMP_DIR=

# Evidencia por fuente, una por archivo y cada una con su propio digest. Así la
# de una fuente no caduca ni se invalida por la de otra.
# SOURCE_ATTESTATION_FILES=config/source-attestation.json,config/source-attestation-city.json

# Snapshots de un ciclo de recolección. Una consulta genera uno, con hash, y el
# paso de sincronización reutiliza ese mismo archivo sin volver a consultar.
# SOURCE_SNAPSHOT_DIR=data/snapshots
# Un snapshot solo se reutiliza desde la sesión que lo creó. La identidad de la
# sesión sale de /proc/sys/kernel/random/boot_id; esto la fuerza en pruebas.
# SOURCE_SESSION_ID=

# ── CRM ──────────────────────────────────────────────────────
# ¿No sabes qué CRM tienes instalado? Averígualo:
#     node scripts/crm.js detect https://tu-crm.com
# Y comprueba la conexión con:
#     node scripts/crm.js status
#     node scripts/crm.js test
#
# Adaptador: none | webhook | espocrm | suitecrm | perfex | vtiger
#            | hubspot | gohighlevel
CRM_DRIVER=twenty

# URL base del CRM (sirve también si está en un subdirectorio: midominio.com/crm)
CRM_BASE_URL=
# EspoCRM: API Key del usuario API · Perfex: authtoken · HubSpot: private app token
# SuiteCRM: Client ID  · Vtiger: Access Key · GHL: token
CRM_API_KEY=
# Solo SuiteCRM: Client Secret
CRM_API_SECRET=
# Solo Vtiger: usuario dueño de la Access Key
CRM_API_USER=
# Solo Go High Level
CRM_LOCATION_ID=
# Opcional: a quién se asignan los leads (Vtiger)
CRM_ASSIGNED_USER_ID=

# Para CRM_DRIVER=webhook: a dónde se POSTea cada lead (n8n, Make, Zapier o tu API).
CRM_WEBHOOK_URL=
# Firma HMAC-SHA256 del cuerpo, en la cabecera X-CaliClean-Signature.
CRM_WEBHOOK_SECRET=

# Enviar al CRM también los leads que entran por el widget, no solo los de
# prospección. Recomendado: si no, el equipo trabaja en dos sitios.
CRM_SYNC_INBOUND=true
