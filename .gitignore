node_modules/
.env
preview/

# Base de datos local y sus archivos auxiliares de SQLite.
data/*.db
data/*.db-shm
data/*.db-wal

# Constancias de verificación de fuentes: son propias de cada despliegue, con
# sus fechas. Compartirlas haría creer que una fuente está verificada aquí
# porque alguien la verificó en otra máquina.
data/source-compliance.json

# Estado de cuota de las fuentes: cuántas filas y cuándo fue la última corrida
# con éxito en ESTA máquina. Versionarlo regalaría cuota ajena, o la quitaría.
data/source-runtime-state.json
data/source-runtime-state.json.*
data/source-runtime-state.json.lock

*.log
.DS_Store

# Snapshots de fuentes: datos de negocio recogidos de registros públicos, con
# hash y atados a la sesión que los creó. Son resultados, no código.
data/snapshots/

# Staging de los scouts de la fase 3: candidatos saneados, con hash, runId y
# caducidad. Resultados, no codigo.
data/staging/

# Lock de la orquestacion de la fase 3.
data/phase3.lock

# Copias de seguridad previas a una escritura del piloto: registros reales del
# CRM, con su estado anterior. Son datos del cliente, no código, y se escriben
# con permisos 600 porque eso es lo que son.
data/backups/
