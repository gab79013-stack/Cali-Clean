[Unit]
Description=Cali Clean · API, paneles y captación
After=network.target

[Service]
Type=simple
User=caliclean
WorkingDirectory=/opt/caliclean
EnvironmentFile=/opt/caliclean/.env
# El worker corre en su propio servicio: así un reinicio de la API no
# interrumpe una corrida de los agentes a media cadena.
Environment=WORKER_DISABLED=1
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# La app solo necesita escribir en su carpeta de datos.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/caliclean/data

[Install]
WantedBy=multi-user.target
