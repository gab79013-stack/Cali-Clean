{
  "name": "cali-clean-leadgen",
  "version": "1.0.0",
  "private": true,
  "description": "Lead generation machine for Cali Clean (cali-clean.net) - instant quote funnel, lead scoring, bilingual email nurture over Sender SMTP/API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "seed": "node scripts/seed.js",
    "test:email": "node scripts/test-email.js",
    "test": "node --test test/*.test.js",
    "twenty:schema": "NODE_USE_ENV_PROXY=1 node scripts/twenty-sync.js schema",
    "twenty:dry-run": "NODE_USE_ENV_PROXY=1 node scripts/twenty-sync.js dry-run",
    "sources:status": "node scripts/verify-sources.js",
    "sources:attestation": "node scripts/verify-attestation.js",
    "sources:dry-run": "node scripts/dry-run-source.js",
    "sources:preview": "NODE_USE_ENV_PROXY=1 node scripts/source-run.js preview",
    "sources:sync": "NODE_USE_ENV_PROXY=1 node scripts/source-run.js sync",
    "sources:preview:city": "NODE_USE_ENV_PROXY=1 node scripts/source-run.js preview --source sd_business_tax_certificates",
    "enrich:preview": "NODE_USE_ENV_PROXY=1 node scripts/enrich-preview.js",
    "routine:daily": "NODE_USE_ENV_PROXY=1 node scripts/routine-daily.js",
    "routine:daily:write": "NODE_USE_ENV_PROXY=1 TWENTY_WRITE_ENABLED=true node scripts/routine-daily.js --write",
    "phase3:preview": "NODE_USE_ENV_PROXY=1 node scripts/phase3-run.js preview",
    "phase3:plan": "NODE_USE_ENV_PROXY=1 node scripts/phase3-run.js plan"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16"
  }
}
